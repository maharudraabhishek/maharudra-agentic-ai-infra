{
  "name": "@maharudra/agentic-ai-infra-runtime",
  "version": "0.1.0",
  "description": "Runtime adapters, storage, retrieval, and context services for MahaRudra Agentic AI Infra.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.contract-tests.json --noEmit && vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@maharudra/agentic-ai-infra-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.0.0"
  }
}
